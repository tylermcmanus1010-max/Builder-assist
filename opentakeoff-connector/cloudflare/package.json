{
  "name": "builder-assist-opentakeoff-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "typecheck": "tsc --noEmit",
    "check": "npm run types && npm run typecheck",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:worker-dry-run": "wrangler deploy --dry-run --containers-rollout=none",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "@cloudflare/containers": "0.3.7" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  }
}
