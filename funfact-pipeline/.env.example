# Copy to .env and fill in, or export these in your shell / CI secrets.
# Never commit real values.

# If your platform reserves/strips the name ANTHROPIC_API_KEY (Claude Code
# remote environments do), use FUNFACT_ANTHROPIC_API_KEY instead.
ANTHROPIC_API_KEY=sk-ant-...
FAL_KEY=...
# Only needed when image_provider is replicate (or auto with no FAL_KEY).
# replicate.com -> account -> API tokens.
REPLICATE_API_TOKEN=...
ELEVENLABS_API_KEY=...

# Optional overrides (defaults: ./client_secret.json, ./token.json)
# YT_CLIENT_SECRET_PATH=
# YT_TOKEN_PATH=
